#!/usr/bin/env bash
# Boxbox session-start hook. Tells the agent that Boxbox is installed and,
# if this repo has work in progress, where it stands. Prints JSON; never fails the session.
set -u

msg="Boxbox is installed. For any feature, bug fix or planning work bigger than a one-line change, use the boxbox skill before doing anything else. It plans the work, asks the developer for decisions, builds one tested unit at a time, and stops for the developer's review after each unit."

if [ -f ".boxbox/state.md" ]; then
  state="$(head -c 1500 .boxbox/state.md 2>/dev/null || true)"
  msg="${msg}

This repo uses Boxbox. Read .boxbox/GUIDE.md and .boxbox/lessons.md before writing anything. Current state (.boxbox/state.md):
${state}

If waiting_for_developer is yes, do not build anything until the developer answers."
fi

escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}
ctx="$(escape "$msg")"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context": "%s"}\n' "$ctx"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "%s"}}\n' "$ctx"
else
  printf '{"additionalContext": "%s"}\n' "$ctx"
fi
exit 0
